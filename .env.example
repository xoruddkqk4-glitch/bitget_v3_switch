# ==============================================================================
# Bitget API & Telegram Configuration Template
# ==============================================================================

# Bitget 선물 API 키 설정 (https://www.bitget.com)
BITGET_API_KEY=your_bitget_api_key_here
BITGET_SECRET=your_bitget_secret_here
BITGET_PASSPHRASE=your_bitget_passphrase_here

# 텔레그램 알림 봇 설정 (Telegram BotFather 및 userinfobot 참조)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 모의 매매 (Paper Trading) 여부 (true: 가상 잔고/모의 체결, false: 실제 선물 주문)
PAPER_TRADING=true
MOCK_BALANCE=10000.0

# 일봉 신호 소스 (ls: 미국 SOXL 현물 일봉, 15:54~15:59 ET 평가 / bitget: 기존 Bitget 1D 캔들, 09:10 KST 평가 - 롤백용)
DAILY_SIGNAL_SOURCE=ls

# 미국 현물 당일 시가 검증 (DAILY_SIGNAL_SOURCE=ls 전용)
# |시가/전일종가-1| 이 OPEN_GAP_ALERT_PCT 초과 시 야후 원본·LS g3101 시가와 교차검증, 편차가 OPEN_CROSSCHECK_TOL_PCT 초과면 '시가 의심'
OPEN_GAP_ALERT_PCT=0.08
OPEN_CROSSCHECK_TOL_PCT=0.005
# true: 시가 의심 시 캔들(±1.5%) 조건만 무효화 / false(기본): 텔레그램 경고 + logs/us_bar_audit.jsonl 기록만
OPEN_SUSPECT_BLOCK_CANDLE=false
