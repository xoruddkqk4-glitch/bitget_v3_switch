# ==============================================================================
# Bitget API & Telegram Configuration Template
# ==============================================================================

# Bitget 선물 API 키 설정 (https://www.bitget.com)
BITGET_API_KEY=your_bitget_api_key_here
BITGET_SECRET=your_bitget_secret_here
BITGET_PASSPHRASE=your_bitget_passphrase_here

# 텔레그램 알림 봇 설정 (Telegram BotFather 및 userinfobot 참조)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 모의 매매 (Paper Trading) 여부 (true: 가상 잔고/모의 체결, false: 실제 선물 주문)
PAPER_TRADING=true
MOCK_BALANCE=10000.0
